APP_NAME=LarAdmin
APP_ENV=local
APP_KEY=
# ⚠️ 生产环境必须为 false。本项目所有 /admin/* 与 /api/* 都强制走 JSON 错误响应，
#    APP_DEBUG=true 时接口 500 会把异常类名/堆栈/文件行号原样回给调用方（已在线上
#    实测过）。本模板服务本地开发所以留 true；生产值由 deploy.yml 的
#    「Pin production env」步骤每次部署强制覆盖，不靠人手工记得改。
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laradmin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=laradmin

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

QUEUE_CONNECTION=redis

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT 认证：生产环境务必用 `php artisan jwt:secret` 生成，勿使用示例值
JWT_SECRET=
JWT_TTL=120
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true

# LaravelS（Swoole 常驻运行时）
LARAVELS_LISTEN_IP=0.0.0.0
LARAVELS_LISTEN_PORT=8000
LARAVELS_WORKER_NUM=4
LARAVELS_TASK_WORKER_NUM=10
LARAVELS_DAEMONIZE=false
LARAVELS_TIMER=true
LARAVELS_WEBSOCKET=true
LARAVELS_INOTIFY_RELOAD=false
LARAVELS_LOG_LEVEL=4
LARAVELS_MAX_REQUEST=5000

# 对象存储：按实际使用的驱动填写其一（系统支持 s3/minio/oss/rustfs）
FILESYSTEM_DISK=local
# --- S3 兼容 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# --- MinIO ---
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REGION=
# --- 阿里云 OSS ---
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=

# ============================================================================
# 说明：
# 1. SERVER_HOST / SERVER_USER / SERVER_SSH_KEY 不是本文件的环境变量，而是
#    GitHub 仓库 Settings → Secrets and variables → Actions 中的部署密钥，
#    请勿写进 .env，也不要提交到仓库。
# 2. 运行时 PHP 统一为 8.5；mbstring 缺口由 app/Support/mb_polyfill.php 兜底补齐。
# ============================================================================
