{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "require": {
    "php": "^8.3",
    "hhxsv5/laravel-s": "^3.8",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.9",
    "maatwebsite/excel": "^4.0",
    "symfony/polyfill-mbstring": "^1.38",
    "tymon/jwt-auth": "^2.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "files": [
      "app/Support/mb_polyfill.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Hhxsv5\\LaravelS\\": "vendor/hhxsv5/laravel-s/src",
      "Modules\\": "modules/",
      "Modules\\Order\\": "modules/Order/",
      "Modules\\Stock\\": "modules/Stock/",
      "Modules\\Delivery\\": "modules/Delivery/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Tests\\Auth\\": "modules/Auth/tests/",
      "Tests\\Delivery\\": "modules/Delivery/tests/",
      "Tests\\Miniapp\\": "modules/Miniapp/tests/",
      "Tests\\Office\\": "modules/Office/tests/",
      "Tests\\Order\\": "modules/Order/tests/",
      "Tests\\Report\\": "modules/Report/tests/",
      "Tests\\Stock\\": "modules/Stock/tests/",
      "Tests\\System\\": "modules/System/tests/",
      "Tests\\VanSales\\": "modules/VanSales/tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.3.0",
      "ext-swoole": "4.8.0",
      "ext-pcntl": "8.3.0"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [{
    "name": "packagist",
    "type": "composer",
    "url": "https://mirrors.tencent.com/composer/"
  }]
}
